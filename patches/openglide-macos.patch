Patch: OpenGLide-ng Darwin platform declarations and clock inventory
Upstream: eugenenuke/openglide-ng at OPENGLIDE in tools/check_macos_backend.py.
Original: platform selection excludes Apple targets and CPU clock inventory reads Linux /proc/cpuinfo.
Replacement: use the Unix Glide ABI on Darwin and query hw.cpufrequency in the existing upstream clock function; return zero when unavailable.
Effect: both Mac architectures compile the renderer while retaining an unknown inventory value on Apple Silicon systems that omit CPU frequency. Linux behavior is unchanged.
Why: the Mac renderer uses the shared SDL window and upstream OpenGL implementation.
Evidence: platforms/macos/build_renderer.sh cross-links the renderer and triangle fixture for Intel and Apple Silicon. ClockFrequency is used for renderer inventory in GLutil.cpp. No Mac execution is claimed.

--- a/sdk2_3dfx.h
+++ b/sdk2_3dfx.h
@@ -22,7 +22,7 @@
 #ifndef __3DFX_H__
 #define __3DFX_H__
 
-#if defined(__unix__) || (__MINGW32__)
+#if defined(__unix__) || defined(__APPLE__) || (__MINGW32__)
 #include "sdk2_unix.h"
 #else
 /*
@@ -86,7 +86,7 @@
 #elif defined(__DJGPP__)
 #  define FX_ENTRY extern
 #  define FX_CALL
-#elif defined(__unix__)
+#elif defined(__unix__) || defined(__APPLE__)
 #  define FX_ENTRY extern
 #  define FX_CALL
 #elif defined(__MWERKS__)
--- a/sdk2_glidesys.h
+++ b/sdk2_glidesys.h
@@ -81,7 +81,7 @@
 #endif
 
 /* Check for OS */
-#if defined(__IRIX__) || defined(__sparc__) || defined(__linux__)
+#if defined(__IRIX__) || defined(__sparc__) || defined(__linux__) || defined(__APPLE__)
 #  define GLIDE_OS        GLIDE_OS_UNIX
 #elif defined(__DOS__)
 #  define GLIDE_OS        GLIDE_OS_DOS32
--- a/platform/linux/clock.cpp
+++ b/platform/linux/clock.cpp
@@ -14,9 +14,21 @@
 #include <stdio.h>
 #include <string.h>
 #include "platform/clock.h"
+#if defined(__APPLE__)
+#include <sys/sysctl.h>
+#include <stdint.h>
+#endif
 
 float ClockFrequency( void )
 {
+#if defined(__APPLE__)
+    uint64_t hz = 0;
+    size_t size = sizeof hz;
+    // Apple Silicon may not expose this inventory-only value. Zero is unknown.
+    if (sysctlbyname("hw.cpufrequency", &hz, &size, nullptr, 0) || size != sizeof hz)
+        return 0;
+    return static_cast<float>(hz);
+#else
     char  str[35];
     float freq = 0.0;
     FILE *f = fopen ("/proc/cpuinfo", "r");
@@ -32,6 +44,7 @@
     }
     fclose (f);
     return freq * 1000000.0;
+#endif
 }
 
 #endif // WIN32
