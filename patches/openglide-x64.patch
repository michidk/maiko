+        return;
+    fbo.BindFramebuffer( RG_FRAMEBUFFER, 0 );
+    fbo.DeleteFramebuffers( 1, &RgOffscreenFbo );
+    fbo.DeleteRenderbuffers( 2, RgOffscreenBuffers );
+    RgOffscreenFbo = 0;
+}
+
+// Scales the finished frame into a window of drawable size w x h, keeping the game's aspect with
+// black bars, then calls RgPresentHook. Leaves the window's framebuffer bound for the swap.
+void RgPresentOffscreen( int w, int h )
+{
+    int W = OpenGL.WindowWidth, H = OpenGL.WindowHeight;
+    int dw = w, dh = (int)( (long long)w * H / W );
+    if ( dh > h ) {
+        dh = h;
+        dw = (int)( (long long)h * W / H );
+    }
+    int x = ( w - dw ) / 2, y = ( h - dh ) / 2;
+    glPushAttrib( GL_COLOR_BUFFER_BIT | GL_SCISSOR_BIT | GL_VIEWPORT_BIT );
+    fbo.BindFramebuffer( RG_READ_FRAMEBUFFER, RgOffscreenFbo );
+    fbo.BindFramebuffer( RG_DRAW_FRAMEBUFFER, 0 );
+    glDisable( GL_SCISSOR_TEST );
+    glColorMask( GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE );
+    glClearColor( 0.f, 0.f, 0.f, 1.f );
+    glClear( GL_COLOR_BUFFER_BIT );
+    fbo.BlitFramebuffer( 0, 0, W, H, x, y, x + dw, y + dh, GL_COLOR_BUFFER_BIT, GL_LINEAR );
+    glViewport( 0, 0, w, h );
+    if ( RgPresentHook )
+        RgPresentHook( );
+    glPopAttrib( );
+}
+
+// Called after the swap so the next frame draws offscreen again.
+void RgResumeOffscreen( void )
+{
+    fbo.BindFramebuffer( RG_FRAMEBUFFER, RgOffscreenFbo );
+}
 
