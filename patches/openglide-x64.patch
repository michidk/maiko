+// Offscreen rendering, so the window can have any size: the game draws into a framebuffer of the
+// size chosen when the window opened, and each swap scales it into the window with 4:3 bars.
+#ifndef APIENTRY
+#define APIENTRY
+#endif
+#define RG_FRAMEBUFFER           0x8D40
+#define RG_READ_FRAMEBUFFER      0x8CA8
+#define RG_DRAW_FRAMEBUFFER      0x8CA9
+#define RG_RENDERBUFFER          0x8D41
+#define RG_COLOR_ATTACHMENT0     0x8CE0
+#define RG_DEPTH_ATTACHMENT      0x8D00
+#define RG_FRAMEBUFFER_COMPLETE  0x8CD5
+#define RG_RGBA8                 0x8058
+#define RG_DEPTH_COMPONENT24     0x81A6
+static struct {
+    void (APIENTRY *GenFramebuffers)(GLsizei, GLuint *);
+    void (APIENTRY *DeleteFramebuffers)(GLsizei, const GLuint *);
+    void (APIENTRY *BindFramebuffer)(GLenum, GLuint);
+    void (APIENTRY *GenRenderbuffers)(GLsizei, GLuint *);
+    void (APIENTRY *DeleteRenderbuffers)(GLsizei, const GLuint *);
+    void (APIENTRY *BindRenderbuffer)(GLenum, GLuint);
+    void (APIENTRY *RenderbufferStorage)(GLenum, GLenum, GLsizei, GLsizei);
+    void (APIENTRY *FramebufferRenderbuffer)(GLenum, GLenum, GLenum, GLuint);
+    GLenum (APIENTRY *CheckFramebufferStatus)(GLenum);
+    void (APIENTRY *BlitFramebuffer)(GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLbitfield, GLenum);
+} fbo;
+static GLuint RgOffscreenBuffers[2];
+
+// Called by the platform window with the new context current, once its render size is known.
+bool RgCreateOffscreen( int width, int height )
+{
+    if ( getenv( "RG_NO_OFFSCREEN" ) )
+        return false;
+    *(void **)&fbo.GenFramebuffers = (void *)OGLGetProcAddress( "glGenFramebuffers" );
+    *(void **)&fbo.DeleteFramebuffers = (void *)OGLGetProcAddress( "glDeleteFramebuffers" );
+    *(void **)&fbo.BindFramebuffer = (void *)OGLGetProcAddress( "glBindFramebuffer" );
+    *(void **)&fbo.GenRenderbuffers = (void *)OGLGetProcAddress( "glGenRenderbuffers" );
+    *(void **)&fbo.DeleteRenderbuffers = (void *)OGLGetProcAddress( "glDeleteRenderbuffers" );
+    *(void **)&fbo.BindRenderbuffer = (void *)OGLGetProcAddress( "glBindRenderbuffer" );
+    *(void **)&fbo.RenderbufferStorage = (void *)OGLGetProcAddress( "glRenderbufferStorage" );
+    *(void **)&fbo.FramebufferRenderbuffer = (void *)OGLGetProcAddress( "glFramebufferRenderbuffer" );
+    *(void **)&fbo.CheckFramebufferStatus = (void *)OGLGetProcAddress( "glCheckFramebufferStatus" );
+    *(void **)&fbo.BlitFramebuffer = (void *)OGLGetProcAddress( "glBlitFramebuffer" );
+    if ( !fbo.GenFramebuffers || !fbo.DeleteFramebuffers || !fbo.BindFramebuffer ||
+         !fbo.GenRenderbuffers || !fbo.DeleteRenderbuffers || !fbo.BindRenderbuffer ||
+         !fbo.RenderbufferStorage || !fbo.FramebufferRenderbuffer ||
+         !fbo.CheckFramebufferStatus || !fbo.BlitFramebuffer )
+        return false;
+    GLuint frame;
+    fbo.GenFramebuffers( 1, &frame );
+    fbo.GenRenderbuffers( 2, RgOffscreenBuffers );
+    fbo.BindRenderbuffer( RG_RENDERBUFFER, RgOffscreenBuffers[0] );
+    fbo.RenderbufferStorage( RG_RENDERBUFFER, RG_RGBA8, width, height );
+    fbo.BindRenderbuffer( RG_RENDERBUFFER, RgOffscreenBuffers[1] );
+    fbo.RenderbufferStorage( RG_RENDERBUFFER, RG_DEPTH_COMPONENT24, width, height );
+    fbo.BindFramebuffer( RG_FRAMEBUFFER, frame );
+    fbo.FramebufferRenderbuffer( RG_FRAMEBUFFER, RG_COLOR_ATTACHMENT0, RG_RENDERBUFFER, RgOffscreenBuffers[0] );
+    fbo.FramebufferRenderbuffer( RG_FRAMEBUFFER, RG_DEPTH_ATTACHMENT, RG_RENDERBUFFER, RgOffscreenBuffers[1] );
+    if ( fbo.CheckFramebufferStatus( RG_FRAMEBUFFER ) != RG_FRAMEBUFFER_COMPLETE || glGetError( ) ) {
+        fbo.BindFramebuffer( RG_FRAMEBUFFER, 0 );
+        fbo.DeleteFramebuffers( 1, &frame );
+        fbo.DeleteRenderbuffers( 2, RgOffscreenBuffers );
+        return false;
+    }
+    glDrawBuffer( RG_COLOR_ATTACHMENT0 );
+    glReadBuffer( RG_COLOR_ATTACHMENT0 );
+    RgOffscreenFbo = frame;
+    return true;
+}
+
+// Called by the platform window before its context is released.
