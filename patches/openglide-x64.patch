+
+// Per-pixel fog. Glide looks the fog density up per pixel from the pixel's depth, but the fixed
+// pipeline can only interpolate a density computed at the three vertices, so fog on large triangles
+// (water, ground) steps and swims as the camera moves. A third texture unit does the lookup per pixel
+// instead: the fog coordinate array carries 1/w, which is linear across a screen-space triangle, and a
+// 1D texture sampled with it holds the density (piecewise linear in 1/w, as Glide's table is).
+#ifndef GL_TEXTURE2_ARB
+#define GL_TEXTURE2_ARB 0x84C2
+#endif
+#ifndef GL_CLAMP_TO_EDGE
+#define GL_CLAMP_TO_EDGE 0x812F
+#endif
+#ifndef GL_ALPHA16
+#define GL_ALPHA16 0x803E
+#endif
+#define FOG_TEXELS 16384
+#define FOG_OOW_MAX 0.25f
+
+static bool    s_fog_dirty = true;
+static GLuint  s_fog_texture = 0;
+static int     s_pixel_fog_support = -1;
+
+void RenderFogTableChanged( void )
+{
+    s_fog_dirty = true;
+}
+
+static bool PixelFogSupported( void )
+{
+    if ( s_pixel_fog_support < 0 )
+    {
+        GLint size = 0;
+        s_pixel_fog_support = 0;
+        if ( InternalConfig.ARB_multitexture && InternalConfig.EXT_texture_env_combine &&
+             InternalConfig.EXT_fog_coord && OpenGL.MultiTextureTMUs >= 3 &&
+             p_glClientActiveTexture && p_glActiveTextureARB && p_glMultiTexCoord4fARB &&
+             !getenv( "RG_VERTEX_FOG" ) )
+        {
+            glGetIntegerv( GL_MAX_TEXTURE_SIZE, &size );
+            s_pixel_fog_support = ( size >= FOG_TEXELS ) ? 1 : 0;
+        }
+    }
+    return s_pixel_fog_support == 1;
+}
+
+static bool PixelFogActive( void )
+{
+    return InternalConfig.FogEnable && OpenGL.Fog && Glide.State.FogMode == GR_FOG_WITH_TABLE &&
+           PixelFogSupported( );
+}
+
+static void PixelFogBegin( void )
+{
+    GLfloat color[ 4 ];
+
+    if ( s_fog_dirty )
+    {
+        static unsigned short texels[ FOG_TEXELS ];
+        for ( int i = 0; i < FOG_TEXELS; i++ )
+        {
+            float oow = ( i + 0.5f ) * FOG_OOW_MAX / FOG_TEXELS;
+            float w = 1.0f / oow;
+            texels[ i ] = (unsigned short)( OGLFogDistance( w > 65535.f ? 65535.f : w ) * 65535.f + 0.5f );
+        }
+        if ( !s_fog_texture )
+        {
+            glGenTextures( 1, &s_fog_texture );
+        }
+        p_glActiveTextureARB( GL_TEXTURE2_ARB );
+        glBindTexture( GL_TEXTURE_1D, s_fog_texture );
+        glTexParameteri( GL_TEXTURE_1D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
+        glTexParameteri( GL_TEXTURE_1D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+        glTexParameteri( GL_TEXTURE_1D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE );
+        glPixelStorei( GL_UNPACK_ALIGNMENT, 1 );
+        glTexImage1D( GL_TEXTURE_1D, 0, GL_ALPHA16, FOG_TEXELS, 0, GL_ALPHA, GL_UNSIGNED_SHORT, texels );
+        s_fog_dirty = false;
+    }
+    glGetFloatv( GL_FOG_COLOR, color );
+    glDisable( GL_FOG );
+    p_glActiveTextureARB( GL_TEXTURE2_ARB );
+    glEnable( GL_TEXTURE_1D );
+    glBindTexture( GL_TEXTURE_1D, s_fog_texture );
+    glTexEnvi( GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_COMBINE );
+    glTexEnvfv( GL_TEXTURE_ENV, GL_TEXTURE_ENV_COLOR, color );
+    // fog colour * density + previous colour * (1 - density); alpha passes through
+    glTexEnvi( GL_TEXTURE_ENV, GL_COMBINE_RGB, GL_INTERPOLATE );
+    glTexEnvi( GL_TEXTURE_ENV, GL_SOURCE0_RGB, GL_CONSTANT );
+    glTexEnvi( GL_TEXTURE_ENV, GL_OPERAND0_RGB, GL_SRC_COLOR );
+    glTexEnvi( GL_TEXTURE_ENV, GL_SOURCE1_RGB, GL_PREVIOUS );
+    glTexEnvi( GL_TEXTURE_ENV, GL_OPERAND1_RGB, GL_SRC_COLOR );
+    glTexEnvi( GL_TEXTURE_ENV, GL_SOURCE2_RGB, GL_TEXTURE );
+    glTexEnvi( GL_TEXTURE_ENV, GL_OPERAND2_RGB, GL_SRC_ALPHA );
+    glTexEnvi( GL_TEXTURE_ENV, GL_COMBINE_ALPHA, GL_REPLACE );
+    glTexEnvi( GL_TEXTURE_ENV, GL_SOURCE0_ALPHA, GL_PREVIOUS );
+    glTexEnvi( GL_TEXTURE_ENV, GL_OPERAND0_ALPHA, GL_SRC_ALPHA );
+    p_glActiveTextureARB( GL_TEXTURE0_ARB );
+    if ( InternalConfig.EXT_vertex_array )
+    {
+        p_glClientActiveTexture( GL_TEXTURE2_ARB );
+        glEnableClientState( GL_TEXTURE_COORD_ARRAY );
+        glTexCoordPointer( 1, GL_FLOAT, 0, &OGLRender.TFog[ 0 ] );
+        p_glClientActiveTexture( GL_TEXTURE0_ARB );
+    }
+}
+
+static void PixelFogEnd( void )
+{
+    p_glActiveTextureARB( GL_TEXTURE2_ARB );
+    glDisable( GL_TEXTURE_1D );
+    p_glActiveTextureARB( GL_TEXTURE0_ARB );
+    if ( InternalConfig.EXT_vertex_array )
+    {
+        p_glClientActiveTexture( GL_TEXTURE2_ARB );
+        glDisableClientState( GL_TEXTURE_COORD_ARRAY );
+        p_glClientActiveTexture( GL_TEXTURE0_ARB );
+    }
+    glEnable( GL_FOG );
+}
