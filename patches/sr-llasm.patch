+EXTERNC void CCALL x87_fstp_extended(CPU, uint8_t *bytes)
+{
+    double value = ST0;
+    uint64_t significand = 0;
+    unsigned int exponent = 0;
+    int power, i;
+    if (isnan(value)) { significand = UINT64_C(0xc000000000000000); exponent = 0x7fff; }
+    else if (isinf(value)) { significand = UINT64_C(0x8000000000000000); exponent = 0x7fff; }
+    else if (value != 0.0)
+    {
+        double fraction = frexp(fabs(value), &power);
+        significand = (uint64_t)ldexp(fraction, 64);
+        exponent = power + 16382;
+    }
+    if (signbit(value)) exponent |= 0x8000;
+    for (i = 0; i < 8; ++i) bytes[i] = (uint8_t)(significand >> (8 * i));
+    bytes[8] = (uint8_t)exponent;
+    bytes[9] = (uint8_t)(exponent >> 8);
+    POP_REGS;
+}
