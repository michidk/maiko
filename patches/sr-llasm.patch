+EXTERNC void CCALL x87_fprem_void(CPU)
+{
+    double dividend = ST0, divisor = ST(1), nearest, result;
+    int nearest_quotient = 0;
+    unsigned int quotient = 0;
+    result = fmod(dividend, divisor);
+    if (isfinite(dividend) && !isnan(divisor) && divisor != 0.0)
+    {
+        nearest = remquo(dividend, divisor, &nearest_quotient);
+        quotient = (unsigned int)(nearest_quotient < 0 ? -nearest_quotient : nearest_quotient);
+        if (nearest != result) --quotient;
+    }
+    ST0 = result;
+    st_sw_cond = ((quotient & 4) ? X87_C0 : 0) |
+                 ((quotient & 2) ? X87_C3 : 0) | ((quotient & 1) ? X87_C1 : 0);
+}
+
+EXTERNC void CCALL x87_frndint_void(CPU)
+{
+    double value = ST0;
+    double rounded;
+    switch ((st_cw >> X87_RC_SHIFT) & 3)
+    {
+    case 0:
+        rounded = floor(value);
+        if (value - rounded > 0.5 ||
+            (value - rounded == 0.5 && fmod(rounded, 2.0) != 0.0))
+        {
+            rounded += 1.0;
+        }
+        break;
+    case 1:
+        rounded = floor(value);
+        break;
+    case 2:
+        rounded = ceil(value);
+        break;
+    default:
+        rounded = trunc(value);
+        break;
+    }
+    ST0 = copysign(rounded, value);
+    CLEAR_X87_FLAGS;
+}
+
