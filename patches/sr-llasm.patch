+EXTERNC void CCALL x87_fld_extended(CPU, const uint8_t *bytes)
+{
+    uint64_t significand = 0;
+    unsigned int exponent;
+    double value;
+    int i;
+    for (i = 0; i < 8; ++i) significand |= (uint64_t)bytes[i] << (8 * i);
+    exponent = bytes[8] | ((unsigned int)(bytes[9] & 0x7f) << 8);
+    if (exponent == 0x7fff)
+        value = significand == UINT64_C(0x8000000000000000) ? INFINITY : NAN;
+    else if (exponent && !(significand >> 63))
+        value = NAN;
+    else
+        value = ldexp((double)significand, (int)(exponent ? exponent : 1) - 16383 - 63);
+    PUSH_REGS;
+    ST0 = copysign(value, (bytes[9] & 0x80) ? -1.0 : 1.0);
+}
