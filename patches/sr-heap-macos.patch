     mach_msg_type_number_t count;
     mach_port_t object_name;
+    kern_return_t region_result;
 
     pointer_offset = 0;
 
@@ -1377,7 +1385,10 @@
     {
         region_address = maddr;
         count = VM_REGION_BASIC_INFO_COUNT_64;
-        if (KERN_SUCCESS != mach_vm_region(task, &region_address, &region_size, VM_REGION_BASIC_INFO_64, (vm_region_info_t) &rinfo, &count, &object_name)) break;
+        object_name = MACH_PORT_NULL;
+        region_result = mach_vm_region(task, &region_address, &region_size, VM_REGION_BASIC_INFO_64, (vm_region_info_t) &rinfo, &count, &object_name);
+        if (object_name != MACH_PORT_NULL) mach_port_deallocate(task, object_name);
